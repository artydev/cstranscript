<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>

		<!-- ── TAILLE DES REQUÊTES ─────────────────────────────────────────────
         Limite globale : 101 Mo — couvre /transcribe-audio (fichier entier
         jusqu'à 100 Mo, défini par MaxFileSize dans Program.cs).
         La limite spécifique à /transcribe-chunk (15 Mo) est définie
         dans le bloc <location> ci-dessous.
    ──────────────────────────────────────────────────────────────────────── -->
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="105906176" />
			</requestFiltering>
		</security>

		<!-- ── COMPRESSION ────────────────────────────────────────────────────
         La compression dynamique IIS bufferise la réponse avant envoi,
         ce qui casse les flux SSE (text/event-stream).
         Désactivée ici — les chunks audio sont déjà compressés (MP3/WebM).
    ──────────────────────────────────────────────────────────────────────── -->
		<urlCompression doStaticCompression="true" doDynamicCompression="false" />

		<!-- ── MODULE ASPNETCORE ──────────────────────────────────────────────
         hostingModel="inprocess" recommandé pour les performances.
         Ajuster arguments selon le nom du binaire publié.
    ──────────────────────────────────────────────────────────────────────── -->
		<aspNetCore processPath="dotnet"
					arguments=".\AudioTranscript.Presentation.JSChunk.dll"
					stdoutLogEnabled="false"
					stdoutLogFile=".\logs\stdout"
					hostingModel="inprocess" />

	</system.webServer>

	<!-- ── LIMITE SPÉCIFIQUE AU ENDPOINT CHUNK ──────────────────────────────
       Chunks bruts 10 Mo + overhead multipart → 15 Mo suffit.
       Surcharge la limite globale pour ce seul endpoint.
  ──────────────────────────────────────────────────────────────────────── -->
	<location path="transcript/transcribe-chunk">
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="15728640" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>

</configuration>