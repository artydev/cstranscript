  <ItemGroup>
    <Content Remove="dotnet-tools.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly" Version="8.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DevHelp\doc.html" />
